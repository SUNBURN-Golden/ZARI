  "capabilities": [
    {
      "id": "owned",
      "canonical": "OwnedContainer on ProjectInput, copied by value into the snapshot",
      "sourceFile": "crates/core/src/catalog.rs",
      "sourceMarker": "struct OwnedContainer",
      "overlap": "quantity_owned and quantity_available are Fact values. Unknown is not zero. A library edit does not rewrite an old snapshot. Explicit apply copies into the project. Owned units are consumed once.",
      "gap": "No purchase, return, move, or quantity-edit event log. Items are not owned-container lifecycle rows. Empty and in-use are not a separate state from quantity facts.",
      "owner": "z-inventory-lifecycle",
      "implementsNow": false
    },
    {
      "id": "realProduct",
      "canonical": "CatalogSnapshot digest, sourceKind synthetic or imported",
      "sourceFile": "crates/core/src/catalog.rs",
      "sourceMarker": "enum CatalogSourceKind",
      "overlap": "Product, variant, and offer keep separate outer and inner facts and provenance. validateCatalog is the import boundary. Synthetic ids stay synthetic. An empty catalogue is origin empty-real and invents no product.",
      "gap": "No verified source kind, no CSV row diagnostic workbench, and no photo byte as catalog truth.",
      "owner": "z-catalog-provenance",
      "implementsNow": false
    },
    {
      "id": "strategyComparison",
      "canonical": "Strategy and StrategyDecision from proposeStrategies, then ranked PlanSnapshot alternatives",
      "sourceFile": "crates/core/src/strategy.rs",
      "sourceMarker": "enum Strategy",
      "overlap": "Five strategies carry rule ids and fact refs. Search publishes ranked alternatives from one input and budget. Layout equivalence is not a prose duplicate.",
      "gap": "No Pareto read model of cost, reuse, prior moves, unassigned count, and unknown count. No user recipe library beyond the Recipe struct.",
      "owner": "z-strategy-library",
      "laterOwner": "z-pareto-comparison",
      "implementsNow": false
    },
    {
      "id": "export",
      "canonical": "exportVersion 1 JSON envelope, Rust verifyRecord before an atomic import",
      "sourceFile": "apps/web/src/persistence/export.ts",
      "sourceMarker": "EXPORT_VERSION = 1",
      "overlap": "Standard export names excluded photo bytes. Duplicate resets progress and does not reserve owned stock. Recovery export is labeled unvalidated.",
      "gap": "No selectable attachment bundle, no zip, and no path-escape or compression-bomb rejection beyond the JSON bounds.",
      "owner": "z-portable-project",
      "implementsNow": false
    },
    {
      "id": "reorganize",
      "canonical": "A new PlanSnapshot only from evaluate_candidate after an explicit input or layout change",
      "sourceFile": "crates/core/src/finalize.rs",
      "sourceMarker": "fn evaluate_candidate",
      "overlap": "Recompute allocates a new snapshot id. Progress does not move to that binding. Locked zones are already input constraints. A checkbox does not rewrite the old plan.",
      "gap": "No pinned-placement incremental replan and no feedback loop that keeps the current plan while drafting the next one.",
      "owner": "z-incremental-replan",
      "laterOwner": "z-feedback-reorganize",
      "implementsNow": false
    }
  ],
